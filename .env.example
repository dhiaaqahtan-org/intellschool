APP_NAME="InstiKit Premium"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_MODE=live
APP_URL=https://school.example.com
APP_VERSION=5.5.0

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_TYPE=mysql
DB_ENGINE=InnoDB
DB_STRICT=true
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=instikit
DB_USERNAME=instikit
DB_PASSWORD=

# Name of the default team/institute created on first seed.
# The super-admin account is created by ApplicationSeeder
# (default login: admin@gmail.com / 12345678 — change it after logging in).
DEFAULT_TEAM_NAME=Default

# Academic period created by DefaultAcademicPeriodSeeder when a team has none.
# Leave these unset to use the current July-June academic year automatically.
DEFAULT_PERIOD_NAME=
DEFAULT_PERIOD_CODE=
DEFAULT_PERIOD_SHORTCODE=
DEFAULT_PERIOD_ALIAS=
DEFAULT_PERIOD_START_DATE=
DEFAULT_PERIOD_END_DATE=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
# Hosts allowed to use cookie/session (SPA) auth — MUST include your APP_URL host.
# Production: set your domain, e.g. school.example.com (and www.school.example.com).
# Local dev:  localhost,localhost:*,127.0.0.1,127.0.0.1:*,::1
SANCTUM_STATEFUL_DOMAINS=school.example.com

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_URL=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_APP_ENV="${APP_ENV}"
VITE_APP_URL="${APP_URL}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

TELESCOPE_ENABLED=false

# Uncomment only when using an additional volume with the "vol" disk.
# VOLUME_PATH=
# PUBLIC_PATH=

#--------------------------------------------------------------------------
# SaaS multi-tenancy (Modules/Saas)
#--------------------------------------------------------------------------
# Master switch. While false the app behaves exactly as the original
# single-tenant ERP: ResolveTenant passes every request straight through.
# Turning this on REQUIRES a migrated landlord database and at least one
# provisioned tenant, or every request 404s.
SAAS_TENANCY_ENABLED=false
SAAS_CANCELLATION_RETENTION_DAYS=90

# Hosts. These decide which site answers "/", so they must differ from each
# other and from any tenant hostname.
#   marketing -> the public SaaS product website
#   platform  -> signup, billing, platform administration
#   suffix    -> tenants are issued <slug><suffix>
# Leave marketing unset in local dev and it falls back to "localhost", so:
#   http://localhost:8000  -> marketing site
#   http://127.0.0.1:8000  -> the school/tenant site
# In production an unset marketing host registers NO marketing routes, rather
# than shadowing every tenant's own school website.
SAAS_MARKETING_HOST=
SAAS_PLATFORM_HOST=
SAAS_TENANT_SUFFIX=

# Control plane. MUST be a different database from the ERP and from every
# tenant. There is no fallback: an unset value fails to connect on purpose.
SAAS_LANDLORD_DB_DATABASE=
# SAAS_LANDLORD_DB_HOST=
# SAAS_LANDLORD_DB_USERNAME=
# SAAS_LANDLORD_DB_PASSWORD=

# Tenant database cluster. Development only — EnvTenantCredentialResolver
# refuses to run in production; bind a secret-manager resolver there.
# SAAS_CLUSTER_DEFAULT_HOST=
# SAAS_CLUSTER_DEFAULT_USERNAME=
# SAAS_CLUSTER_DEFAULT_PASSWORD=

# Marketing claim gates. Each stays false until the evidence exists; the views
# hide the corresponding claim while it is false. Do not enable to "look
# finished" — publishing unapproved pricing is a contractual exposure.
SAAS_CLAIM_PRICING=false
SAAS_CLAIM_CUSTOMERS=false
SAAS_CLAIM_UPTIME=false
SAAS_CLAIM_CERTS=false
SAAS_CLAIM_MOBILE_GA=false

# Self-service remains fail-closed until pricing/legal approval, owner email
# delivery, queue workers, and provisioning infrastructure are operational.
SAAS_PUBLIC_SIGNUP_ENABLED=false
SAAS_OWNER_INVITATIONS_ENABLED=false
SAAS_INVITATION_EXPIRY_DAYS=7
SAAS_PROVISION_QUEUE=provisioning

# Initial control-plane operator. Required only when running
# PlatformUserSeeder; never commit real credentials.
SAAS_PLATFORM_ADMIN_EMAIL=
SAAS_PLATFORM_ADMIN_NAME="Platform Administrator"
SAAS_PLATFORM_ADMIN_PASSWORD=

# Demo lead retention and optional notification delivery.
SAAS_LEAD_NOTIFY_EMAIL=
SAAS_LEAD_QUEUE=notifications
SAAS_LEAD_RETENTION_DAYS=90

# Platform subscription billing. "null" is the safe non-billing adapter.
# Configure and bind an approved provider adapter before changing this value.
SAAS_BILLING_PROVIDER=null
SAAS_BILLING_WEBHOOK_SECRET=
SAAS_BILLING_UPGRADE_URL=
# SAAS_BILLING_API_KEY=
# SAAS_BILLING_API_SECRET=
SAAS_BILLING_GRACE_DAYS=7
SAAS_BILLING_RECONCILE_CRON="0 */6 * * *"
